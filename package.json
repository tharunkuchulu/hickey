{
  "name": "hickey",
  "version": "0.1.0",
  "private": true,
  "description": "Hickey POS — offline-first cafe billing system",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @hickey/pos dev",
    "build": "pnpm -r build",
    "build:pos": "pnpm --filter @hickey/pos build",
    "dist:pos": "pnpm --filter @hickey/pos dist",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @hickey/db generate",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
