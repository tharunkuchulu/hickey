{
  "extends": "../../tsconfig.base.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/types/**/*", "../../packages/*/src/**/*"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "types": ["electron-vite/node"],
    "noEmit": true,
    "paths": { "@main/*": ["./src/main/*"] }
  }
}
