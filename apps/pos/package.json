{
  "name": "@hickey/pos",
  "version": "0.1.2",
  "private": true,
  "productName": "Hickey POS",
  "description": "Hickey POS — cafe billing desktop app",
  "author": "Hickey",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
